# Copy this to .env and fill in real values.

PORT=8787

# Any long random string — must match the LISTENER_API_KEY secret set on the Cloudflare Worker
# (wrangler secret put LISTENER_API_KEY). This is what stops randoms from hitting your endpoints
# or your Worker's /webhook/personal route.
LISTENER_API_KEY=change-me-to-a-long-random-string

# The deployed Cloudflare Worker's URL, e.g. https://psg-whatsapp-bot.<subdomain>.workers.dev
# (same value goes into LISTENER_BASE_URL in cloudflare/wrangler.toml)
WORKER_BASE_URL=
